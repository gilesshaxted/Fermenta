filters:
  and:
    - type == "region"
properties:
  note.country:
    displayName: Country
  note.area:
    displayName: Area
  note.level:
    displayName: Level
  note.climate:
    displayName: Climate
  note.soils:
    displayName: Soils
  note.grapes:
    displayName: Grapes
views:
  - type: table
    name: All Regions
    groupBy:
      property: country
      direction: ASC
    order:
      - file.name
      - area
      - level
      - climate
      - soils
      - grapes
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Main Regions
    filters:
      and:
        - level == "region"
    groupBy:
      property: country
      direction: ASC
    order:
      - file.name
      - climate
      - soils
      - grapes
  - type: map
    name: World Map
    order:
      - file.name
      - country
      - area
      - level
      - climate
      - soils
      - grapes
    coordinates: note.coordinates
    center: 30, 10
    defaultZoom: 2
    minZoom: 1
    maxZoom: 14
    mapHeight: 600
