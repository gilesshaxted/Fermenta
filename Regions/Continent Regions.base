filters:
  and:
    - type == "region"
    - continent == this.file.name
properties:
  note.country:
    displayName: Country
  note.area:
    displayName: Area
  note.level:
    displayName: Level
  note.climate:
    displayName: Climate
  note.soils:
    displayName: Soils
  note.grapes:
    displayName: Grapes
views:
  - type: map
    name: Map
    order:
      - file.name
      - country
      - area
      - level
      - climate
      - soils
      - grapes
    coordinates: note.coordinates
    center: 30.0, 10.0
    defaultZoom: 2
    minZoom: 2
    maxZoom: 14
    mapHeight: 600
  - type: table
    name: Table
    groupBy:
      property: country
      direction: ASC
    order:
      - file.name
      - level
      - climate
      - soils
      - grapes
    sort:
      - property: file.name
        direction: ASC
