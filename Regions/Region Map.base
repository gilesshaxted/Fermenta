filters:
  and:
    - type == "region"
    - or:
        - file.name == this.file.name
        - file.hasLink(this.file)
        - this.file.hasLink(file)
views:
  - type: map
    name: Location
    order:
      - file.name
      - country
      - area
      - level
      - climate
      - soils
      - grapes
    coordinates: note.coordinates
    defaultZoom: 6
    minZoom: 2
    maxZoom: 14
    mapHeight: 360
