filters:
  and:
    - type == "shop"
properties:
  note.category:
    displayName: Type
  note.area:
    displayName: Area
  note.website:
    displayName: Website
views:
  - type: table
    name: By type
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - area
      - website
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By area
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - category
    sort:
      - property: file.name
        direction: ASC
