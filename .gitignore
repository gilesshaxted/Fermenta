# Obsidian: share only the Fermenta theme and the plugins this vault needs
.obsidian/*
!.obsidian/themes/
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/plugins/

# Themes: only Fermenta
.obsidian/themes/*
!.obsidian/themes/Fermenta/

# Plugins: only these three
.obsidian/plugins/*
!.obsidian/plugins/maps/
!.obsidian/plugins/explorer-sort/
!.obsidian/plugins/omnisearch/

# Never share plugin settings, except the explorer-sort folder order
.obsidian/plugins/**/data.json
!.obsidian/plugins/explorer-sort/data.json
*.bak
.obsidian/plugins/omnisearch/*.json
!.obsidian/plugins/omnisearch/manifest.json

# Personal and system files
.trash/
.DS_Store
Thumbs.db

# Website build files
.site/.build/
